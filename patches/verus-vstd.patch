+
+verus! {
+
+#[verifier::external_type_specification]
+#[verifier::external_body]
+pub struct ExLocation<'a>(Location<'a>);
+
+pub struct LocationView {
+    pub file: Seq<char>,
+    pub line: u32,
+    pub column: u32,
+}
+
+impl<'a> View for Location<'a> {
+    type V = LocationView;
+
+    #[verifier::external_body]
+    uninterp spec fn view(&self) -> LocationView;
+}
+
+pub assume_specification<'a>[ Location::file ](location: &Location<'a>) -> (result: &'a str)
+    ensures
+        result@ == location@.file,
+;
+
+pub assume_specification<'a>[ Location::file_as_c_str ](location: &Location<'a>) -> (result:
+    &'a core::ffi::CStr)
+    ensures
+        result@ == encode_utf8(location@.file),
+;
+
+pub assume_specification<'a>[ Location::line ](location: &Location<'a>) -> (result: u32)
+    ensures
+        result == location@.line,
+;
+
+pub assume_specification<'a>[ Location::column ](location: &Location<'a>) -> (result: u32)
+    ensures
+        result == location@.column,
+;
+
+} // verus!
