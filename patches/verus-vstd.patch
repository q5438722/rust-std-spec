@@ -0,0 +1,236 @@
+//! Experimental specifications for additional `alloc::collections` types.
+use super::super::laws_eq::obeys_concrete_eq;
+use super::super::multiset::Multiset;
+use super::super::prelude::*;
+
+use alloc::collections::{BinaryHeap, LinkedList};
+use alloc::vec::Vec;
+use core::alloc::Allocator;
+
+verus! {
+
+#[verifier::external_type_specification]
+#[verifier::external_body]
+#[verifier::accept_recursive_types(T)]
+#[verifier::reject_recursive_types(A)]
+pub struct ExBinaryHeap<T, A: Allocator>(BinaryHeap<T, A>);
+
+#[verifier::external_type_specification]
+#[verifier::external_body]
+#[verifier::accept_recursive_types(T)]
+#[verifier::reject_recursive_types(A)]
+pub struct ExLinkedList<T, A: Allocator>(LinkedList<T, A>);
+
+impl<T, A: Allocator> View for BinaryHeap<T, A> {
+    type V = Multiset<T>;
+
+    #[verifier::external_body]
+    uninterp spec fn view(&self) -> Multiset<T>;
+}
+
+impl<T, A: Allocator> View for LinkedList<T, A> {
+    type V = Seq<T>;
+
+    #[verifier::external_body]
+    uninterp spec fn view(&self) -> Seq<T>;
+}
+
+impl<T: DeepView, A: Allocator> DeepView for LinkedList<T, A> {
+    type V = Seq<T::V>;
+
+    open spec fn deep_view(&self) -> Seq<T::V> {
+        Seq::new(self@.len(), |i: int| self@[i].deep_view())
+    }
+}
+
+pub assume_specification<T>[ BinaryHeap::<T>::new ]() -> (result: BinaryHeap<T>)
+    ensures
+        result@ == Multiset::<T>::empty(),
+;
+
+pub assume_specification<T, A: Allocator>[ BinaryHeap::<T, A>::len ](
+    heap: &BinaryHeap<T, A>,
+) -> (result: usize)
+    ensures
+        result as nat == heap@.len(),
+;
+
+pub assume_specification<T, A: Allocator>[ BinaryHeap::<T, A>::is_empty ](
+    heap: &BinaryHeap<T, A>,
+) -> (result: bool)
+    ensures
+        result <==> heap@.len() == 0,
+;
+
+pub assume_specification<T, A: Allocator>[ BinaryHeap::<T, A>::clear ](heap: &mut BinaryHeap<T, A>)
+    ensures
+        final(heap)@ == Multiset::<T>::empty(),
+;
+
+pub assume_specification<T: Ord, A: Allocator>[ BinaryHeap::<T, A>::push ](
+    heap: &mut BinaryHeap<T, A>,
+    item: T,
+)
+    ensures
+        final(heap)@ == old(heap)@.insert(item),
+;
+
+pub assume_specification<T: Ord, A: Allocator>[ BinaryHeap::<T, A>::append ](
+    heap: &mut BinaryHeap<T, A>,
+    other: &mut BinaryHeap<T, A>,
+)
+    ensures
+        final(heap)@ == old(heap)@.add(old(other)@),
+        final(other)@ == Multiset::<T>::empty(),
+;
+
+pub assume_specification<T: Ord, A: Allocator>[ BinaryHeap::<T, A>::pop ](
+    heap: &mut BinaryHeap<T, A>,
+) -> (result: Option<T>)
+    ensures
+        match result {
+            None => {
+                &&& old(heap)@.len() == 0
+                &&& final(heap)@ == old(heap)@
+            },
+            Some(value) => {
+                &&& old(heap)@.contains(value)
+                &&& final(heap)@ == old(heap)@.remove(value)
+            },
+        },
+;
+
+pub assume_specification<T, A: Allocator>[ BinaryHeap::<T, A>::peek ](
+    heap: &BinaryHeap<T, A>,
+) -> (result: Option<&T>)
+    ensures
+        result is None <==> heap@.len() == 0,
+        result matches Some(value) ==> heap@.contains(*value),
+;
+
+pub assume_specification<T, A: Allocator>[ BinaryHeap::<T, A>::as_slice ](
+    heap: &BinaryHeap<T, A>,
+) -> (result: &[T])
+    ensures
+        result@.to_multiset() == heap@,
+;
+
+pub assume_specification<T, A: Allocator>[ BinaryHeap::<T, A>::into_vec ](
+    heap: BinaryHeap<T, A>,
+) -> (result: Vec<T, A>)
+    ensures
+        result@.to_multiset() == heap@,
+;
+
+pub assume_specification<T: Ord, A: Allocator>[ BinaryHeap::<T, A>::into_sorted_vec ](
+    heap: BinaryHeap<T, A>,
+) -> (result: Vec<T, A>)
+    ensures
+        result@.to_multiset() == heap@,
+;
+
+pub assume_specification<T>[ LinkedList::<T>::new ]() -> (result: LinkedList<T>)
+    ensures
+        result@ == Seq::<T>::empty(),
+;
+
+pub assume_specification<T, A: Allocator>[ LinkedList::<T, A>::len ](
+    list: &LinkedList<T, A>,
+) -> (result: usize)
+    ensures
+        result as nat == list@.len(),
+;
+
+pub assume_specification<T, A: Allocator>[ LinkedList::<T, A>::is_empty ](
+    list: &LinkedList<T, A>,
+) -> (result: bool)
+    ensures
+        result <==> list@.len() == 0,
+;
+
+pub assume_specification<T, A: Allocator>[ LinkedList::<T, A>::contains ](
+    list: &LinkedList<T, A>,
+    value: &T,
+) -> (result: bool) where T: core::cmp::PartialEq<T>
+    requires
+        obeys_concrete_eq::<T>(),
+    ensures
+        result <==> list@.contains(*value),
+;
+
+pub assume_specification<T, A: Allocator>[ LinkedList::<T, A>::clear ](list: &mut LinkedList<T, A>)
+    ensures
+        final(list)@ == Seq::<T>::empty(),
+;
+
+pub assume_specification<T, A: Allocator>[ LinkedList::<T, A>::push_front ](
+    list: &mut LinkedList<T, A>,
+    item: T,
+)
+    ensures
+        final(list)@ == seq![item] + old(list)@,
+;
+
+pub assume_specification<T, A: Allocator>[ LinkedList::<T, A>::push_back ](
+    list: &mut LinkedList<T, A>,
+    item: T,
+)
+    ensures
+        final(list)@ == old(list)@.push(item),
+;
+
+pub assume_specification<T, A: Allocator>[ LinkedList::<T, A>::pop_front ](
+    list: &mut LinkedList<T, A>,
+) -> (result: Option<T>)
+    ensures
+        old(list)@.len() == 0 ==> result is None && final(list)@ == old(list)@,
+        old(list)@.len() > 0 ==> (result matches Some(value) && value == old(list)@[0]
+            && final(list)@ == old(list)@.drop_first()),
+;
+
+pub assume_specification<T, A: Allocator>[ LinkedList::<T, A>::pop_back ](
+    list: &mut LinkedList<T, A>,
+) -> (result: Option<T>)
+    ensures
+        old(list)@.len() == 0 ==> result is None && final(list)@ == old(list)@,
+        old(list)@.len() > 0 ==> (result matches Some(value) && value == old(list)@.last()
+            && final(list)@ == old(list)@.drop_last()),
+;
+
+pub assume_specification<T, A: Allocator>[ LinkedList::<T, A>::front ](
+    list: &LinkedList<T, A>,
+) -> (result: Option<&T>)
+    ensures
+        list@.len() == 0 ==> result is None,
+        list@.len() > 0 ==> (result matches Some(value) && *value == list@[0]),
+;
+
+pub assume_specification<T, A: Allocator>[ LinkedList::<T, A>::back ](
+    list: &LinkedList<T, A>,
+) -> (result: Option<&T>)
+    ensures
+        list@.len() == 0 ==> result is None,
+        list@.len() > 0 ==> (result matches Some(value) && *value == list@.last()),
+;
+
+pub assume_specification<T>[ LinkedList::<T>::append ](
+    list: &mut LinkedList<T>,
+    other: &mut LinkedList<T>,
+)
+    ensures
+        final(list)@ == old(list)@ + old(other)@,
+        final(other)@ == Seq::<T>::empty(),
+;
+
+pub assume_specification<T, A: Allocator>[ LinkedList::<T, A>::split_off ](
+    list: &mut LinkedList<T, A>,
+    at: usize,
+) -> (result: LinkedList<T, A>) where A: Clone
+    requires
+        at <= old(list)@.len(),
+    ensures
+        final(list)@ == old(list)@.take(at as int),
+        result@ == old(list)@.skip(at as int),
+;
+
+} // verus!
diff --git a/source/vstd/std_specs/duration.rs b/source/vstd/std_specs/duration.rs
new file mode 100644
index 00000000..645f3751
--- /dev/null
+++ b/source/vstd/std_specs/duration.rs
@@ -0,0 +1,433 @@
+//! Experimental specifications for `core::time::Duration`.
+use super::super::arithmetic::power2::pow2;
+use super::super::float::{FloatBitsProperties, ieee_float_cast};
+use super::super::prelude::*;
+
+use core::time::{Duration, TryFromFloatSecsError};
+
+verus! {
+
+pub open spec fn nanos_per_second() -> nat {
+    1_000_000_000
+}
+
+pub open spec fn duration_max_nanos() -> nat {
+    u64::MAX as nat * nanos_per_second() + 999_999_999
+}
+
+/// True when executable floating-point operations follow the RFC 3514
+/// finite-result semantics modeled by Verus's deterministic IEEE spec operators.
+pub uninterp spec fn duration_float_ieee_semantics() -> bool;
+
+pub enum TryFromFloatSecsErrorView {
+    Negative,
+    OverflowOrNan,
+}
+
+#[verifier::external_type_specification]
+#[verifier::external_body]
+pub struct ExTryFromFloatSecsError(TryFromFloatSecsError);
+
+impl View for TryFromFloatSecsError {
+    type V = TryFromFloatSecsErrorView;
+
+    #[verifier::external_body]
+    uninterp spec fn view(&self) -> TryFromFloatSecsErrorView;
+}
+
+pub open spec fn duration_secs_f32_is_negative(secs: f32) -> bool {
+    let bits = secs.to_bits_abs_spec() as nat;
+    secs.is_sign_negative_spec() && bits != 0 && !secs.is_nan_spec()
+}
+
+pub open spec fn duration_secs_f64_is_negative(secs: f64) -> bool {
+    let bits = secs.to_bits_abs_spec() as nat;
+    secs.is_sign_negative_spec() && bits != 0 && !secs.is_nan_spec()
+}
+
+pub open spec fn duration_secs_f32_valid(secs: f32) -> bool {
+    !duration_secs_f32_is_negative(secs) && secs.to_bits_abs_spec() as nat / 0x80_0000 < 191
+}
+
+pub open spec fn duration_secs_f64_valid(secs: f64) -> bool {
+    !duration_secs_f64_is_negative(secs) && secs.to_bits_abs_spec() as nat / 0x10_0000_0000_0000
+        < 1087
+}
+
+pub open spec fn duration_from_secs_f32_nanos(secs: f32) -> nat {
+    let bits = secs.to_bits_abs_spec() as nat;
+    let exponent = bits / 0x80_0000;
+    let mantissa = bits % 0x80_0000;
+    let significand = if exponent == 0 {
+        mantissa
+    } else {
+        0x80_0000 + mantissa
+    };
+    let numerator = if exponent < 150 {
+        1_000_000_000 * significand
+    } else {
+        1_000_000_000 * significand * pow2((exponent - 150) as nat)
+    };
+    let denominator = if exponent < 150 {
+        if exponent == 0 {
+            pow2(149)
+        } else {
+            pow2((150 - exponent) as nat)
+        }
+    } else {
+        1
+    };
+    let quotient = numerator / denominator;
+    let remainder = numerator % denominator;
+    if remainder * 2 < denominator {
+        quotient
+    } else if remainder * 2 > denominator || quotient % 2 == 1 {
+        quotient + 1
+    } else {
+        quotient
+    }
+}
+
+pub open spec fn duration_from_secs_f64_nanos(secs: f64) -> nat {
+    let bits = secs.to_bits_abs_spec() as nat;
+    let exponent = bits / 0x10_0000_0000_0000;
+    let mantissa = bits % 0x10_0000_0000_0000;
+    let significand = if exponent == 0 {
+        mantissa
+    } else {
+        0x10_0000_0000_0000 + mantissa
+    };
+    let numerator = if exponent < 1075 {
+        1_000_000_000 * significand
+    } else {
+        1_000_000_000 * significand * pow2((exponent - 1075) as nat)
+    };
+    let denominator = if exponent < 1075 {
+        if exponent == 0 {
+            pow2(1074)
+        } else {
+            pow2((1075 - exponent) as nat)
+        }
+    } else {
+        1
+    };
+    let quotient = numerator / denominator;
+    let remainder = numerator % denominator;
+    if remainder * 2 < denominator {
+        quotient
+    } else if remainder * 2 > denominator || quotient % 2 == 1 {
+        quotient + 1
+    } else {
+        quotient
+    }
+}
+
+pub open spec fn duration_as_secs_f32(nanos: nat) -> f32 {
+    ieee_float_cast::<u64, f32>((nanos / nanos_per_second()) as u64) + ieee_float_cast::<u32, f32>(
+        (nanos % nanos_per_second()) as u32,
+    ) / ieee_float_cast::<u32, f32>(1_000_000_000u32)
+}
+
+pub open spec fn duration_as_secs_f64(nanos: nat) -> f64 {
+    ieee_float_cast::<u64, f64>((nanos / nanos_per_second()) as u64) + ieee_float_cast::<u32, f64>(
+        (nanos % nanos_per_second()) as u32,
+    ) / ieee_float_cast::<u32, f64>(1_000_000_000u32)
+}
+
+pub open spec fn duration_as_nanos_f32(nanos: nat) -> f32 {
+    ieee_float_cast::<u64, f32>((nanos / nanos_per_second()) as u64) * ieee_float_cast::<u32, f32>(
+        1_000_000_000u32,
+    ) + ieee_float_cast::<u32, f32>((nanos % nanos_per_second()) as u32)
+}
+
+pub open spec fn duration_as_nanos_f64(nanos: nat) -> f64 {
+    ieee_float_cast::<u64, f64>((nanos / nanos_per_second()) as u64) * ieee_float_cast::<u32, f64>(
+        1_000_000_000u32,
+    ) + ieee_float_cast::<u32, f64>((nanos % nanos_per_second()) as u32)
+}
+
+impl View for Duration {
+    type V = nat;
+
+    #[verifier::external_body]
+    uninterp spec fn view(&self) -> nat;
+}
+
+pub axiom fn axiom_duration_view_valid(duration: &Duration)
+    ensures
+        duration@ <= duration_max_nanos(),
+;
+
+pub assume_specification[ Duration::new ](secs: u64, nanos: u32) -> (result: Duration)
+    requires
+        secs as nat + nanos as nat / nanos_per_second() <= u64::MAX as nat,
+    ensures
+        result@ == secs as nat * nanos_per_second() + nanos as nat,
+;
+
+pub assume_specification[ Duration::from_secs ](secs: u64) -> (result: Duration)
+    ensures
+        result@ == secs as nat * nanos_per_second(),
+;
+
+pub assume_specification[ Duration::from_millis ](millis: u64) -> (result: Duration)
+    ensures
+        result@ == millis as nat * 1_000_000,
+;
+
+pub assume_specification[ Duration::from_micros ](micros: u64) -> (result: Duration)
+    ensures
+        result@ == micros as nat * 1_000,
+;
+
+pub assume_specification[ Duration::from_nanos ](nanos: u64) -> (result: Duration)
+    ensures
+        result@ == nanos as nat,
+;
+
+pub assume_specification[ Duration::from_nanos_u128 ](nanos: u128) -> (result: Duration)
+    requires
+        nanos as nat <= duration_max_nanos(),
+    ensures
+        result@ == nanos as nat,
+;
+
+pub assume_specification[ Duration::from_hours ](hours: u64) -> (result: Duration)
+    requires
+        hours as nat * 3_600 <= u64::MAX as nat,
+    ensures
+        result@ == hours as nat * 3_600 * nanos_per_second(),
+;
+
+pub assume_specification[ Duration::from_mins ](mins: u64) -> (result: Duration)
+    requires
+        mins as nat * 60 <= u64::MAX as nat,
+    ensures
+        result@ == mins as nat * 60 * nanos_per_second(),
+;
+
+pub assume_specification[ Duration::is_zero ](duration: &Duration) -> (result: bool)
+    ensures
+        result <==> duration@ == 0,
+;
+
+pub assume_specification[ Duration::as_secs ](duration: &Duration) -> (result: u64)
+    ensures
+        result as nat == duration@ / nanos_per_second(),
+;
+
+pub assume_specification[ Duration::as_secs_f32 ](duration: &Duration) -> (result: f32)
+    requires
+        duration_float_ieee_semantics(),
+    ensures
+        result == duration_as_secs_f32(duration@),
+;
+
+pub assume_specification[ Duration::as_secs_f64 ](duration: &Duration) -> (result: f64)
+    requires
+        duration_float_ieee_semantics(),
+    ensures
+        result == duration_as_secs_f64(duration@),
+;
+
+pub assume_specification[ Duration::subsec_millis ](duration: &Duration) -> (result: u32)
+    ensures
+        result as nat == duration@ % nanos_per_second() / 1_000_000,
+;
+
+pub assume_specification[ Duration::subsec_micros ](duration: &Duration) -> (result: u32)
+    ensures
+        result as nat == duration@ % nanos_per_second() / 1_000,
+;
+
+pub assume_specification[ Duration::subsec_nanos ](duration: &Duration) -> (result: u32)
+    ensures
+        result as nat == duration@ % nanos_per_second(),
+;
+
+pub assume_specification[ Duration::as_millis ](duration: &Duration) -> (result: u128)
+    ensures
+        result as nat == duration@ / 1_000_000,
+;
+
+pub assume_specification[ Duration::as_micros ](duration: &Duration) -> (result: u128)
+    ensures
+        result as nat == duration@ / 1_000,
+;
+
+pub assume_specification[ Duration::as_nanos ](duration: &Duration) -> (result: u128)
+    ensures
+        result as nat == duration@,
+;
+
+pub assume_specification[ Duration::abs_diff ](lhs: Duration, rhs: Duration) -> (result: Duration)
+    ensures
+        result@ == if lhs@ >= rhs@ {
+            lhs@ - rhs@
+        } else {
+            rhs@ - lhs@
+        },
+;
+
+pub assume_specification[ Duration::checked_add ](lhs: Duration, rhs: Duration) -> (result: Option<
+    Duration,
+>)
+    ensures
+        lhs@ + rhs@ <= duration_max_nanos() ==> (result matches Some(value) && value@ == lhs@
+            + rhs@),
+        lhs@ + rhs@ > duration_max_nanos() ==> result is None,
+;
+
+pub assume_specification[ Duration::saturating_add ](lhs: Duration, rhs: Duration) -> (result:
+    Duration)
+    ensures
+        result@ == if lhs@ + rhs@ <= duration_max_nanos() {
+            lhs@ + rhs@
+        } else {
+            duration_max_nanos()
+        },
+;
+
+pub assume_specification[ Duration::checked_sub ](lhs: Duration, rhs: Duration) -> (result: Option<
+    Duration,
+>)
+    ensures
+        lhs@ >= rhs@ ==> (result matches Some(value) && value@ == lhs@ - rhs@),
+        lhs@ < rhs@ ==> result is None,
+;
+
+pub assume_specification[ Duration::saturating_sub ](lhs: Duration, rhs: Duration) -> (result:
+    Duration)
+    ensures
+        result@ == if lhs@ >= rhs@ {
+            lhs@ - rhs@
+        } else {
+            0
+        },
+;
+
+pub assume_specification[ Duration::checked_mul ](lhs: Duration, rhs: u32) -> (result: Option<
+    Duration,
+>)
+    ensures
+        lhs@ * rhs as nat <= duration_max_nanos() ==> (result matches Some(value) && value@ == lhs@
+            * rhs as nat),
+        lhs@ * rhs as nat > duration_max_nanos() ==> result is None,
+;
+
+pub assume_specification[ Duration::saturating_mul ](lhs: Duration, rhs: u32) -> (result: Duration)
+    ensures
+        result@ == if lhs@ * rhs as nat <= duration_max_nanos() {
+            lhs@ * rhs as nat
+        } else {
+            duration_max_nanos()
+        },
+;
+
+pub assume_specification[ Duration::checked_div ](lhs: Duration, rhs: u32) -> (result: Option<
+    Duration,
+>)
+    ensures
+        rhs != 0 ==> (result matches Some(value) && value@ == lhs@ / rhs as nat),
+        rhs == 0 ==> result is None,
+;
+
+pub assume_specification[ Duration::mul_f64 ](duration: Duration, rhs: f64) -> (result: Duration)
+    requires
+        duration_float_ieee_semantics(),
+        duration_secs_f64_valid(rhs * duration_as_secs_f64(duration@)),
+    ensures
+        result@ == duration_from_secs_f64_nanos(rhs * duration_as_secs_f64(duration@)),
+;
+
+pub assume_specification[ Duration::mul_f32 ](duration: Duration, rhs: f32) -> (result: Duration)
+    requires
+        duration_float_ieee_semantics(),
+        duration_secs_f32_valid(rhs * duration_as_secs_f32(duration@)),
+    ensures
+        result@ == duration_from_secs_f32_nanos(rhs * duration_as_secs_f32(duration@)),
+;
+
+pub assume_specification[ Duration::div_f64 ](duration: Duration, rhs: f64) -> (result: Duration)
+    requires
+        duration_float_ieee_semantics(),
+        duration_secs_f64_valid(duration_as_secs_f64(duration@) / rhs),
+    ensures
+        result@ == duration_from_secs_f64_nanos(duration_as_secs_f64(duration@) / rhs),
+;
+
+pub assume_specification[ Duration::div_f32 ](duration: Duration, rhs: f32) -> (result: Duration)
+    requires
+        duration_float_ieee_semantics(),
+        duration_secs_f32_valid(duration_as_secs_f32(duration@) / rhs),
+    ensures
+        result@ == duration_from_secs_f32_nanos(duration_as_secs_f32(duration@) / rhs),
+;
+
+pub assume_specification[ Duration::from_secs_f32 ](secs: f32) -> (result: Duration)
+    requires
+        duration_secs_f32_valid(secs),
+    ensures
+        result@ == duration_from_secs_f32_nanos(secs),
+;
+
+pub assume_specification[ Duration::from_secs_f64 ](secs: f64) -> (result: Duration)
+    requires
+        duration_secs_f64_valid(secs),
+    ensures
+        result@ == duration_from_secs_f64_nanos(secs),
+;
+
+pub assume_specification[ Duration::try_from_secs_f32 ](secs: f32) -> (result: Result<
+    Duration,
+    TryFromFloatSecsError,
+>)
+    ensures
+        duration_secs_f32_valid(secs) ==> (result matches Ok(value) && value@
+            == duration_from_secs_f32_nanos(secs)),
+        !duration_secs_f32_valid(secs) ==> (result matches Err(error) && error@
+            == if duration_secs_f32_is_negative(secs) {
+            TryFromFloatSecsErrorView::Negative
+        } else {
+            TryFromFloatSecsErrorView::OverflowOrNan
+        }),
+;
+
+pub assume_specification[ Duration::try_from_secs_f64 ](secs: f64) -> (result: Result<
+    Duration,
+    TryFromFloatSecsError,
+>)
+    ensures
+        duration_secs_f64_valid(secs) ==> (result matches Ok(value) && value@
+            == duration_from_secs_f64_nanos(secs)),
+        !duration_secs_f64_valid(secs) ==> (result matches Err(error) && error@
+            == if duration_secs_f64_is_negative(secs) {
+            TryFromFloatSecsErrorView::Negative
+        } else {
+            TryFromFloatSecsErrorView::OverflowOrNan
+        }),
+;
+
+pub assume_specification[ Duration::div_duration_f32 ](lhs: Duration, rhs: Duration) -> (result:
+    f32)
+    requires
+        duration_float_ieee_semantics(),
+    ensures
+        lhs@ == 0 && rhs@ == 0 ==> result.is_nan_spec(),
+        !(lhs@ == 0 && rhs@ == 0) ==> result == duration_as_nanos_f32(lhs@) / duration_as_nanos_f32(
+            rhs@,
+        ),
+;
+
+pub assume_specification[ Duration::div_duration_f64 ](lhs: Duration, rhs: Duration) -> (result:
+    f64)
+    requires
+        duration_float_ieee_semantics(),
+    ensures
+        lhs@ == 0 && rhs@ == 0 ==> result.is_nan_spec(),
+        !(lhs@ == 0 && rhs@ == 0) ==> result == duration_as_nanos_f64(lhs@) / duration_as_nanos_f64(
+            rhs@,
+        ),
+;
+
+} // verus!
diff --git a/source/vstd/std_specs/ffi.rs b/source/vstd/std_specs/ffi.rs
new file mode 100644
index 00000000..431375af
--- /dev/null
+++ b/source/vstd/std_specs/ffi.rs
@@ -0,0 +1,347 @@
+//! Experimental specifications for `CStr` and `CString`.
+use super::super::prelude::*;
+use super::super::utf8::{decode_utf8, valid_utf8};
+
+use core::ffi::CStr;
+
+#[cfg(feature = "alloc")]
+use alloc::boxed::Box;
+#[cfg(feature = "alloc")]
+use alloc::ffi::CString;
+#[cfg(feature = "alloc")]
+use alloc::string::FromUtf8Error;
+#[cfg(feature = "alloc")]
+use alloc::string::String;
+#[cfg(feature = "alloc")]
+use alloc::vec::Vec;
+
+verus! {
+
+#[verifier::external_type_specification]
+#[verifier::external_body]
+pub struct ExCStr(CStr);
+
+#[verifier::external_type_specification]
+#[verifier::external_body]
+pub struct ExFromBytesWithNulError(core::ffi::FromBytesWithNulError);
+
+#[verifier::external_type_specification]
+#[verifier::external_body]
+pub struct ExFromBytesUntilNulError(core::ffi::FromBytesUntilNulError);
