+//! Experimental specifications for pure `core::net` address values.
+use super::super::prelude::*;
+
+use core::net::{IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr, SocketAddrV4, SocketAddrV6};
+
+verus! {
+
+#[verifier::external_type_specification]
+#[verifier::external_body]
+pub struct ExIpv4Addr(Ipv4Addr);
+
+#[verifier::external_type_specification]
+#[verifier::external_body]
+pub struct ExIpv6Addr(Ipv6Addr);
+
+#[verifier::external_type_specification]
+pub struct ExIpAddr(IpAddr);
+
+#[verifier::external_type_specification]
+#[verifier::external_body]
+pub struct ExSocketAddrV4(SocketAddrV4);
+
+#[verifier::external_type_specification]
+#[verifier::external_body]
+pub struct ExSocketAddrV6(SocketAddrV6);
+
+#[verifier::external_type_specification]
+pub struct ExSocketAddr(SocketAddr);
+
+pub enum IpAddrView {
+    V4(Seq<u8>),
+    V6(Seq<u8>),
+}
+
+pub struct SocketAddrV4View {
+    pub ip: Seq<u8>,
+    pub port: u16,
+}
+
+pub struct SocketAddrV6View {
+    pub ip: Seq<u8>,
+    pub port: u16,
+    pub flowinfo: u32,
+    pub scope_id: u32,
+}
+
+pub enum SocketAddrView {
+    V4(SocketAddrV4View),
+    V6(SocketAddrV6View),
+}
+
+impl View for Ipv4Addr {
+    type V = Seq<u8>;
+
+    #[verifier::external_body]
+    uninterp spec fn view(&self) -> Seq<u8>;
+}
+
+impl View for Ipv6Addr {
+    type V = Seq<u8>;
+
+    #[verifier::external_body]
+    uninterp spec fn view(&self) -> Seq<u8>;
+}
+
+impl View for IpAddr {
+    type V = IpAddrView;
+
+    open spec fn view(&self) -> IpAddrView {
+        match self {
+            IpAddr::V4(address) => IpAddrView::V4(address@),
+            IpAddr::V6(address) => IpAddrView::V6(address@),
+        }
+    }
+}
+
+impl View for SocketAddrV4 {
+    type V = SocketAddrV4View;
+
+    #[verifier::external_body]
+    uninterp spec fn view(&self) -> SocketAddrV4View;
+}
