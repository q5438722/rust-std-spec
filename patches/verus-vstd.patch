+
+pub open spec fn c_string_bytes_valid(bytes: Seq<u8>) -> bool {
+    forall|i: int| 0 <= i < bytes.len() ==> #[trigger] bytes[i] != 0
+}
+
+pub open spec fn c_string_bytes_with_nul_valid(bytes: Seq<u8>) -> bool {
+    bytes.len() > 0 && bytes.last() == 0 && c_string_bytes_valid(bytes.drop_last())
+}
+
+pub open spec fn contains_nul(bytes: Seq<u8>) -> bool {
+    exists|i: int| 0 <= i < bytes.len() && #[trigger] bytes[i] == 0
+}
+
+pub closed spec fn first_nul_index(bytes: Seq<u8>) -> int
+    recommends
+        contains_nul(bytes),
+{
+    choose|i: int|
+        0 <= i < bytes.len() && bytes[i] == 0 && forall|j: int|
+            0 <= j < i ==> #[trigger] bytes[j] != 0
+}
