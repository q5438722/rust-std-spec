  "active_contract_text": "pub assume_specification<T, const N: usize>[ <[T]>::as_chunks_unchecked_mut::<N> ]( slice: &mut [T], ) -> (ret: &mut [[T; N]]) requires N != 0, old(slice)@.len() % (N as nat) == 0, ensures flatten_array_chunks::<T, N>(ret@) == old(slice)@, ret@.len() == old(slice)@.len() / (N as nat), forall|chunk: int| 0 <= chunk < ret@.len() ==> array_value_view::<T, N>(ret@[chunk]) == old(slice)@.subrange(chunk * (N as int), (chunk + 1) * (N as int)), final(ret)@.len() == ret@.len(), final(slice)@ == flatten_array_chunks::<T, N>(final(ret)@), forall|chunk: int| 0 <= chunk < final(ret)@.len() ==> array_value_view::<T, N>(final(ret)@[chunk]) == final(slice)@.subrange(chunk * (N as int), (chunk + 1) * (N as int)), ;",
