  "active_contract_text": "pub assume_specification<T, const N: usize>[ <[T]>::as_chunks_unchecked::<N> ]( slice: &[T], ) -> (ret: &[[T; N]]) requires N != 0, slice@.len() % (N as nat) == 0, ensures flatten_array_chunks::<T, N>(ret@) == slice@, ret@.len() == slice@.len() / (N as nat), forall|chunk: int| 0 <= chunk < ret@.len() ==> array_value_view::<T, N>(ret@[chunk]) == slice@.subrange(chunk * (N as int), (chunk + 1) * (N as int)), ;",
