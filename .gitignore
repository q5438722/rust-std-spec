# Local Python state
.venv/
__pycache__/
*.py[cod]

# Reproducible source/dependency checkouts
nanvix/
rust/
rust-1.96/
verus/
rustdoc-json/
rustdoc-json-1.96/

# Build products and generated executables
target/
target-verus/
contract_harness
det_harness

# Large per-target raw run directories. Aggregate summaries, manifests,
# accepted proofs, audits, and final CSV/JSON reports remain tracked.
**/targets/
source-verification/bulk-proof/runs/
source-verification/determinism-all/targets/
source-verification/determinism-smoke/
source-verification/feedback-proof/runs/
source-verification/fidelity-retry/runs/
source-verification/fidelity-retry/smoke/
source-verification/fidelity-retry/smoke-proved/

# Keep abstraction-audit summaries, but omit thousands of reproducible
# per-API verifier logs and generated harnesses.
specgen/abstraction-audits/*/*/

# Repeated intermediate universe manifests. The current top-level manifests,
# classification CSVs, and round summaries remain tracked.
specgen/abstraction-round*/classified-manifest.json
specgen/abstraction-round*/stable-uncovered-manifest.json
specgen/remaining-generation/all-remaining-manifest.json
specgen/remaining-generation/groups/

# Editor/OS noise
.DS_Store
*.swp
*.swo
